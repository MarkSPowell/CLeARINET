<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end tests of real Fiddler Classic extensions ported onto
       CLeARINET's compatibility layer. Not in CLeARINET.sln, because the
       ports need upstream source fetched by port.ps1; CI runs this in its
       own job on both Windows and macOS. See ../README.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Clearinet.ExtensionPorts.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Clearinet.Compatibility/Clearinet.Compatibility.csproj" />
    <ProjectReference Include="../../../src/Clearinet.ProxyCore/Clearinet.ProxyCore.csproj" />
    <!-- Built first, but not referenced: the tests load its .dll the way the
         app does, through ExtensionHost, from a folder of its own. -->
    <ProjectReference Include="../FiddlerImportNetlog/FiddlerImportNetlog.Port.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PrivacyScanner/PrivacyScanner.Port.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The CSP Rule Collector is a CLeARINET-only fork with its own project,
       which port.ps1 copies into .work/CLeARINETCSP/ once a commit is pinned
       (or when given -CspSource). Built from there; its tests are included
       only when it's present. -->
  <PropertyGroup>
    <CspProject>$(MSBuildThisFileDirectory)../.work/CLeARINETCSP/CLeARINETCSP.csproj</CspProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(CspProject)')">
    <ProjectReference Include="$(CspProject)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(CspProject)')">
    <Compile Remove="CspRuleCollectorPortTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
