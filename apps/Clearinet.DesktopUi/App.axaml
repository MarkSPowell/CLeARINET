<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Clearinet.DesktopUi.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Overriding FluentTheme's accent keys is how the built-in Button /
           CheckBox / DataGrid-selection / focus-ring styling picks up
           CLeARINET's cyan instead of stock Fluent blue, without having to
           hand-write ControlThemes for every control that reads them. The
           three Light/Dark steps are FluentTheme's own convention (hover,
           pressed, disabled states); values here are just even steps
           lightened/darkened from the base accent below. -->
      <Color x:Key="SystemAccentColor">#2DD4E8</Color>
      <Color x:Key="SystemAccentColorLight1">#5EE2F0</Color>
      <Color x:Key="SystemAccentColorLight2">#8CEBF5</Color>
      <Color x:Key="SystemAccentColorLight3">#BAF4FA</Color>
      <Color x:Key="SystemAccentColorDark1">#22B8CC</Color>
      <Color x:Key="SystemAccentColorDark2">#1897A8</Color>
      <Color x:Key="SystemAccentColorDark3">#0E7685</Color>

      <!-- App-specific brushes for the panels/borders/text FluentTheme's
           accent system doesn't drive on its own, used directly in
           MainWindow.axaml, matching the dark navy + cyan look of
           clearinet.webp so the splash screen and the window it hands off
           to feel like the same app. -->
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E1A" />
      <SolidColorBrush x:Key="AppPanelBrush" Color="#131826" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#232A3D" />
      <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8891A7" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#2DD4E8" />
      <SolidColorBrush x:Key="AppSuccessBrush" Color="#34D399" />
      <SolidColorBrush x:Key="AppErrorBrush" Color="#F87171" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- DataGrid ships its own theme separately from FluentTheme; without
         this include the control renders unstyled. -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>
</Application>
