<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clearinet.DesktopUi.ViewModels"
        x:Class="Clearinet.DesktopUi.CompareWindow"
        Title="Compare Sessions"
        Width="1200"
        Height="760"
        MinWidth="600"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Icon="avares://Clearinet.DesktopUi/Assets/clearinet.webp"
        Background="{DynamicResource AppBackgroundBrush}">

  <!-- Compare Sessions (Edit > Compare Sessions, Ctrl+W): two sessions'
       requests and responses side by side, compared line by line (see
       SessionComparison and TextDiff in ProxyCore). The rows are built off
       the UI thread in CompareWindow.axaml.cs; each list virtualizes, so a
       large body is fine. -->
  <Window.Resources>
    <DataTemplate x:Key="CompareRowTemplate" x:DataType="vm:CompareRow">
      <Grid ColumnDefinitions="48,*,48,*">
        <TextBlock Grid.Column="0"
                   Text="{Binding LeftNumber}"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   TextAlignment="Right"
                   Margin="0,1,6,1" />
        <Border Grid.Column="1" Background="{Binding LeftBackground}" Padding="4,1">
          <SelectableTextBlock TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12">
            <Run Text="{Binding LeftBefore}" /><Run Text="{Binding LeftChanged}" Background="{x:Static vm:CompareRow.HighlightBrush}" /><Run Text="{Binding LeftAfter}" />
          </SelectableTextBlock>
        </Border>
        <TextBlock Grid.Column="2"
                   Text="{Binding RightNumber}"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   TextAlignment="Right"
                   Margin="0,1,6,1" />
        <Border Grid.Column="3" Background="{Binding RightBackground}" Padding="4,1">
          <SelectableTextBlock TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12">
            <Run Text="{Binding RightBefore}" /><Run Text="{Binding RightChanged}" Background="{x:Static vm:CompareRow.HighlightBrush}" /><Run Text="{Binding RightAfter}" />
          </SelectableTextBlock>
        </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBox.diff ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Keep each row's own colours; mark the selected row (Next/Previous
         difference) with a border instead of the selection background. -->
    <Style Selector="ListBox.diff ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="0,1" />
    </Style>
    <Style Selector="ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">
    <!-- Which session is on which side. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,12,*" Margin="0,0,0,8">
      <TextBlock x:Name="LeftLabel" Grid.Column="0" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock x:Name="RightLabel" Grid.Column="2" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Grid>

    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <CheckBox x:Name="DecodeBodiesBox" Content="Decompress bodies" IsChecked="True" Click="OptionChanged" Margin="0,0,16,0"
                ToolTip.Tip="Compare the content of gzip, deflate, Brotli or zstd bodies, not the compressed bytes." />
      <CheckBox x:Name="FormatBodiesBox" Content="Format JSON and forms" IsChecked="True" Click="OptionChanged" Margin="0,0,16,0"
                ToolTip.Tip="Put each JSON value, and each form field, on its own line, so a difference shows on its own line." />
      <CheckBox x:Name="SortHeadersBox" Content="Ignore header order" IsChecked="False" Click="OptionChanged" Margin="0,0,16,0"
                ToolTip.Tip="Compare headers sorted by name, so the same headers in another order don't count as different." />
      <Button Content="Previous difference" Click="PreviousButton_Click" HotKey="Shift+F8" Margin="0,0,6,0"
              ToolTip.Tip="Shift+F8" />
      <Button Content="Next difference" Click="NextButton_Click" HotKey="F8" Margin="0,0,16,0"
              ToolTip.Tip="F8" />
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
    </WrapPanel>

    <TabControl x:Name="SidesTabs" Padding="0,6,0,0">
      <TabItem x:Name="RequestTab" Header="Request">
        <ListBox x:Name="RequestList"
                 Classes="diff"
                 ItemTemplate="{StaticResource CompareRowTemplate}"
                 Background="{DynamicResource AppPanelBrush}"
                 SelectionMode="Single" />
      </TabItem>
      <TabItem x:Name="ResponseTab" Header="Response">
        <ListBox x:Name="ResponseList"
                 Classes="diff"
                 ItemTemplate="{StaticResource CompareRowTemplate}"
                 Background="{DynamicResource AppPanelBrush}"
                 SelectionMode="Single" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
