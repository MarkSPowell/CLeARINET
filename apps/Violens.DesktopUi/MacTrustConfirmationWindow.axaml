<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Violens.DesktopUi.MacTrustConfirmationWindow"
        Title="Install VioLens's root certificate?"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="avares://Violens.DesktopUi/Assets/violens-icon.png"
        Background="{DynamicResource AppBackgroundBrush}">

  <!-- macOS's security add-trusted-cert has no prompt of its own, so VioLens
       asks here before touching the login keychain. -->
  <StackPanel Margin="24" Spacing="4">
    <TextBlock Text="Install VioLens's root certificate?"
               FontSize="16"
               FontWeight="Bold"
               Foreground="{DynamicResource AppAccentBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10" />
    <TextBlock Text="VioLens needs to add a certificate to your login keychain so it can decrypt this account's HTTPS traffic for inspection. It will only be trusted for your user account -- not system-wide -- and can be removed later with Tools > Remove Root Certificate, or from Keychain Access."
               FontSize="12"
               Foreground="{DynamicResource AppMutedTextBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel"
              Click="CancelButton_Click"
              MinWidth="90" />
      <Button Content="Install"
              Click="InstallButton_Click"
              Classes="accent"
              MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
