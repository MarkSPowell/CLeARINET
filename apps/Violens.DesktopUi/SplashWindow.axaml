<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Violens.DesktopUi.SplashWindow"
        Title="VioLens"
        Width="768"
        Height="429"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#0B0E1A"
        Icon="avares://Violens.DesktopUi/Assets/violens-icon.png">

  <!-- violens.webp is the whole splash design in one image (emblem,
       wordmark and tagline), drawn at twice this window's 768x429 so it
       stays sharp on high-DPI screens. This window is just an undecorated
       frame for it while MainWindow spins up behind the scenes. See
       App.axaml.cs for how long it stays up and when MainWindow takes
       over. -->
  <Image Source="avares://Violens.DesktopUi/Assets/violens.webp"
         Stretch="Uniform" />
</Window>
