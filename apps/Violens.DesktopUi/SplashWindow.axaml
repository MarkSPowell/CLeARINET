<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Violens.DesktopUi.SplashWindow"
        Title="VioLens"
        Width="768"
        Height="429"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#0B0E1A"
        Icon="avares://Violens.DesktopUi/Assets/violens-icon.png">

  <!-- violens.webp is the whole splash, drawn at twice the window size for
       high-DPI screens. -->
  <Image Source="avares://Violens.DesktopUi/Assets/violens.webp"
         Stretch="Uniform" />
</Window>
